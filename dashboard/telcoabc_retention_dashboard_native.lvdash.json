{
  "datasets": [
    {
      "name": "ds_kpi_churn",
      "displayName": "ds_kpi_churn",
      "queryLines": [
        "SELECT ROUND(MAX(churn_rate_pct),2) AS churn_rate FROM <CATALOG>.telcoabc_retention.gold_churn_metrics "
      ]
    },
    {
      "name": "ds_kpi_cm",
      "displayName": "ds_kpi_cm",
      "queryLines": [
        "SELECT ROUND(MAX(competitor_mention_rate)*100,1) AS competitor_mention_rate_pct FROM <CATALOG>.telcoabc_retention.gold_churn_metrics "
      ]
    },
    {
      "name": "ds_kpi_crit",
      "displayName": "ds_kpi_crit",
      "queryLines": [
        "SELECT COUNT(*) AS critical_customers FROM <CATALOG>.telcoabc_retention.gold_churn_risk_scores WHERE risk_tier='Critical' "
      ]
    },
    {
      "name": "ds_kpi_save",
      "displayName": "ds_kpi_save",
      "queryLines": [
        "SELECT ROUND(SUM(saves)/CAST(SUM(total_calls) AS DOUBLE)*100,1) AS overall_save_rate FROM <CATALOG>.telcoabc_retention.gold_churn_metrics "
      ]
    },
    {
      "name": "ds_trend",
      "displayName": "ds_trend",
      "queryLines": [
        "SELECT call_date, churn_rate_pct, ROUND(competitor_mention_rate*100,1) AS competitor_mention_pct FROM <CATALOG>.telcoabc_retention.gold_churn_metrics ORDER BY call_date "
      ]
    },
    {
      "name": "ds_comp_share",
      "displayName": "ds_comp_share",
      "queryLines": [
        "SELECT competitor_name, COUNT(*) AS mention_count FROM <CATALOG>.telcoabc_retention.gold_call_interactions WHERE competitor_mentioned=true GROUP BY competitor_name ORDER BY mention_count DESC "
      ]
    },
    {
      "name": "ds_topics",
      "displayName": "ds_topics",
      "queryLines": [
        "SELECT call_topic, call_volume, ROUND(save_rate*100,1) AS save_rate_pct FROM <CATALOG>.telcoabc_retention.gold_call_topics ORDER BY call_volume DESC "
      ]
    },
    {
      "name": "ds_offers",
      "displayName": "ds_offers",
      "queryLines": [
        "SELECT offer_name, ROUND(save_rate*100,1) AS save_rate_pct, times_presented, times_accepted FROM <CATALOG>.telcoabc_retention.gold_retention_offers ORDER BY save_rate DESC "
      ]
    },
    {
      "name": "ds_agents",
      "displayName": "ds_agents",
      "queryLines": [
        "SELECT agent_name, ROUND(save_rate*100,1) AS save_rate_pct, avg_handle_time_min, tier FROM <CATALOG>.telcoabc_retention.gold_agent_performance ORDER BY save_rate DESC "
      ]
    },
    {
      "name": "ds_lowest",
      "displayName": "ds_lowest",
      "queryLines": [
        "SELECT agent_name, team, tier, ROUND(save_rate*100,1) AS save_rate_pct, ROUND(avg_handle_time_min,1) AS avg_handle_time, ROUND(offer_conversion_rate*100,1) AS offer_conversion_pct FROM <CATALOG>.telcoabc_retention.gold_agent_performance ORDER BY save_rate ASC LIMIT 20 "
      ]
    },
    {
      "name": "ds_critical",
      "displayName": "ds_critical",
      "queryLines": [
        "SELECT customer_id, market, plan_type, monthly_spend, ROUND(churn_score*100,1) AS churn_score_pct, recommended_offer_id, competitor_id FROM <CATALOG>.telcoabc_retention.gold_churn_risk_scores WHERE risk_tier='Critical' ORDER BY churn_score DESC LIMIT 200 "
      ]
    }
  ],
