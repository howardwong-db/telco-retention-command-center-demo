%%{init: {
  "flowchart": {
    "defaultRenderer": "elk",
    "rankSpacing": 85,
    "nodeSpacing": 50,
    "padding": 22
  },
  "themeVariables": {
    "fontSize": "14px",
    "fontFamily": "\"Segoe UI\", Arial, sans-serif",
    "lineColor": "#475569",
    "clusterBkg": "#f8fafc",
    "clusterBorder": "#cbd5e1",
