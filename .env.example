# Copy to .env and fill in for YOUR workspace:  cp .env.example .env
# These drive the data generators, notebook, app, and helper scripts.

# --- Databricks CLI profile (used by generators + scripts locally) ---
DATABRICKS_PROFILE=DEFAULT

# --- Unity Catalog target ---
TELCOABC_CATALOG=main                 # your catalog
TELCOABC_SCHEMA=telcoabc_retention    # schema (safe to keep)

# --- SQL warehouse (Genie space + dashboard + app queries) ---
DATABRICKS_WAREHOUSE_ID=<warehouse_id>

# --- Multi-Agent Supervisor serving endpoint (name of the deployed MAS) ---
SERVING_ENDPOINT=<mas_endpoint_name>

# --- MLflow experiment path (under your own user) ---
MLFLOW_EXPERIMENT=/Users/<your-email>/telcoabc_churn

# --- Lakebase (Postgres) chat persistence ---
PGHOST=<lakebase-host>                # e.g. ep-xxxx.database.<region>.cloud.databricks.com
PGPORT=5432
PGDATABASE=<lakebase-db>
PGSSLMODE=require
LAKEBASE_INSTANCE=<lakebase-instance> # Lakebase instance name (for sync scripts)
LAKEBASE_DB=<lakebase-db>

# --- Local app dev only (NOT needed when running as a Databricks App) ---
# DEV_USER_EMAIL=demo-user@example.com
# DEV_DB_TOKEN=<your-personal-access-token-for-local-dev>
